# Supabase - verejne (jdou do prohlizecoveho bundlu)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase - server only. NIKDY nedavat do NEXT_PUBLIC_*.
# Vsechna herni data ctou a zapisuji API routy timto klicem.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server only. Pepper pro HMAC Traki klice (R17). Vygenerovat: openssl rand -base64 48
# Zmena pepperu zneplatni VSECHNY vydane klice - nikdy nemenit bez planu.
RECOVERY_KEY_PEPPER=your-random-48-byte-secret

# Basic auth pro editor Mozek (/mozek)
ADMIN_BASIC_USER=postope@panbatoh.cz
ADMIN_BASIC_PASS=change-me-strong-password

# Volitelne
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# RATE_LIMIT_OVERRIDES_JSON={"auth_login":{"limit":10}}
